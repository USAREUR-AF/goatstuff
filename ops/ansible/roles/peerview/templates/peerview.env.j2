# {{ ansible_managed }}
#
# Mode 0600, root-owned, outside the served directory. The NetBird management
# token is admin-scoped — listing peers has no read-only role on this build —
# so it is treated as an admin credential and never reaches a command line, a
# committed file, or the docroot.
PEERVIEW_NETBIRD_URL={{ peerview_netbird_url }}
PEERVIEW_NETBIRD_TOKEN={{ peerview_netbird_token }}
PEERVIEW_PORTAL_URL={{ peerview_portal_url }}
PEERVIEW_PORTAL_CONTAINER={{ peerview_portal_container }}
PEERVIEW_PORTAL_NET={{ peerview_portal_network }}
PEERVIEW_PORTAL_PORT={{ peerview_portal_port }}
PEERVIEW_PORTAL_KEY={{ peerview_portal_key }}
PEERVIEW_ID_CONSOLE_URL={{ peerview_id_console_url }}
