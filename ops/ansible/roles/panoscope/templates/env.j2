# Generated by the panoscope Ansible role — do not edit by hand.
RUST_LOG={{ panoscope_rust_log }}
PANOSCOPE_BIND=0.0.0.0:8080
PANOSCOPE_ZENOH_ENDPOINT={{ panoscope_zenoh_endpoint }}
{% if panoscope_zenoh_mtls_enabled %}
PANOSCOPE_ZENOH_MTLS_ENABLED=true
PANOSCOPE_ZENOH_TLS_ROOT_CA={{ panoscope_ca_root_container_path }}
PANOSCOPE_ZENOH_TLS_CLIENT_CERT=/etc/panoscope/zenoh-client-cert.pem
PANOSCOPE_ZENOH_TLS_CLIENT_KEY=/etc/panoscope/zenoh-client-key.pem
{% endif %}
PANOSCOPE_PORTAL_SCHEMAS_URL={{ panoscope_portal_schemas_url }}
PANOSCOPE_PORTAL_REFRESH_SECS={{ panoscope_portal_refresh_secs }}
{% if panoscope_portal_api_key | default('') %}
PANOSCOPE_PORTAL_API_KEY={{ panoscope_portal_api_key }}
{% endif %}
PANOSCOPE_SAMPLING_PER_TOPIC_EPS={{ panoscope_sampling_per_topic_eps }}
PANOSCOPE_WS_COALESCE_MS={{ panoscope_ws_coalesce_ms }}
{% if panoscope_topic_blocklist | default([]) | length > 0 %}
PANOSCOPE_TOPIC_BLOCKLIST={{ panoscope_topic_blocklist | join(',') }}
{% endif %}
{% if panoscope_minio_replay_enabled | default(false) %}
PANOSCOPE_MINIO_REPLAY_ENABLED=true
PANOSCOPE_MINIO_ENDPOINT={{ panoscope_minio_endpoint }}
PANOSCOPE_MINIO_REGION={{ panoscope_minio_region | default('us-east-1') }}
PANOSCOPE_MINIO_BUCKET={{ panoscope_minio_bucket | default('audit-integrity') }}
PANOSCOPE_MINIO_KEY_PREFIX={{ panoscope_minio_key_prefix }}
PANOSCOPE_MINIO_ACCESS_KEY={{ panoscope_minio_access_key }}
PANOSCOPE_MINIO_SECRET_KEY={{ panoscope_minio_secret_key }}
PANOSCOPE_MINIO_WINDOW_HOURS={{ panoscope_minio_window_hours | default(24) }}
PANOSCOPE_MINIO_MAX_OBJECTS={{ panoscope_minio_max_objects | default(20000) }}
{# Deep last-seen backfill: a second, deeper replay pass that runs lazily AFTER
   the fast boot seed (PANOSCOPE_MINIO_WINDOW_HOURS) so deep lens windows fill
   in soon after a cold start without delaying load-up. Only runs when deeper
   than the boot window. docs/design/panoscope-history-lens.md. #}
PANOSCOPE_MINIO_DEEP_WINDOW_HOURS={{ panoscope_minio_deep_window_hours | default(168) }}
{% if panoscope_minio_vendor_blocklist | default([]) | length > 0 %}
PANOSCOPE_MINIO_VENDOR_BLOCKLIST={{ panoscope_minio_vendor_blocklist | join(',') }}
{% endif %}
{% endif %}
{# In-RAM peer evictor: drop peers unseen for longer than this (7d default).
   Independent of MinIO replay — the peer table grows for the life of the
   process otherwise. Keep >= the deepest selectable lens window (168h).
   docs/design/panoscope-history-lens.md. #}
PANOSCOPE_PEER_RETENTION_HOURS={{ panoscope_peer_retention_hours | default(168) }}

# Derived-state snapshot. Restores topology+flow on boot and narrows
# the deep replay to the snapshot's age, so a restart costs an hour of replay
# rather than seven days of it. Set ENABLED=0 to force the full walk every
# time (useful when bisecting a registry-content bug).
PANOSCOPE_STATE_SNAPSHOT_ENABLED={{ 1 if panoscope_state_snapshot_enabled | default(true) | bool else 0 }}
PANOSCOPE_STATE_SNAPSHOT_PATH=/var/lib/panoscope/state-snapshot.json
{% if panoscope_sibling_stethoscope_url | default('') %}
PANOSCOPE_SIBLING_STETHOSCOPE_URL={{ panoscope_sibling_stethoscope_url }}
{% endif %}
{% if panoscope_sibling_flashlight_url | default('') %}
PANOSCOPE_SIBLING_FLASHLIGHT_URL={{ panoscope_sibling_flashlight_url }}
{% endif %}
{% if panoscope_sibling_microscope_url | default('') %}
PANOSCOPE_SIBLING_MICROSCOPE_URL={{ panoscope_sibling_microscope_url }}
{% endif %}
{% if panoscope_sibling_portal_url | default('') %}
PANOSCOPE_SIBLING_PORTAL_URL={{ panoscope_sibling_portal_url }}
{% endif %}
{#
  Display-only lexicon (docs/design/portal-lexicon.md §"Panoscope display
  layer"). Sourced from the SAME group_vars the portal reads so the noun
  never drifts between the two surfaces: `portal_lex_org` (e.g. "org")
  + `portal_lex_product_name` (e.g. "ZAGROS Fabric") for the fabric label. Unset
  → no line emitted → the binary keeps its byte-stable compiled
  defaults. Render-time only; never touches a key/ACL.
#}
{% set _lex_org = panoscope_lex_org | default(portal_lex_org | default('')) %}
{% set _lex_orgs = panoscope_lex_orgs | default(portal_lex_orgs | default('')) %}
{% set _lex_fabric = panoscope_lex_fabric_label | default(portal_lex_product_name | default('')) %}
{% if _lex_org %}
PANOSCOPE_LEX_ORG={{ _lex_org }}
{% endif %}
{% if _lex_orgs %}
PANOSCOPE_LEX_ORGS={{ _lex_orgs }}
{% endif %}
{% if _lex_fabric %}
PANOSCOPE_LEX_FABRIC_LABEL={{ _lex_fabric }}
{% endif %}

# --- Per-viewer RBAC (ADR 1073 enforcement, ADR 1074 role grammar) ---
PANOSCOPE_RBAC_MODE={{ panoscope_rbac_mode }}
PANOSCOPE_RBAC_FULL_GROUPS={{ panoscope_rbac_full_groups }}
PANOSCOPE_RBAC_NOTIONAL_DEFAULT={{ panoscope_rbac_notional_default | lower }}
PANOSCOPE_RBAC_WHO_GROUPS={{ panoscope_rbac_who_groups }}
{# ADR 1074 B1 — enrich a Scoped participant's view with the registry-derived
   data-roles resolved live from the portal (GET /api/access/data-roles). OFF
   until enabled per-goatnet. PRECONDITION when enabling: PANOSCOPE_PORTAL_API_KEY
   must be lookup-authorized (an operator token in PORTAL_OPERATOR_API_KEYS, or
   the console↔portal lookup secret) — the resolver gates on lookupAuthorized;
   a non-authorized key yields 401 and the enrichment fails closed (base scope
   stands, logged). Only meaningful under PANOSCOPE_RBAC_MODE=enforce. #}
{% if panoscope_participant_resolver | default(false) %}
PANOSCOPE_PARTICIPANT_RESOLVER=on
{% endif %}
