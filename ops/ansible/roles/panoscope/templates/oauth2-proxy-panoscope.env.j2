# Rendered by ops/ansible/roles/panoscope/ — DO NOT EDIT ON HOST.
# Mode 0600 root:root. Consumed by the oauth2-proxy-panoscope sidecar
# (ADR 1073 — authenticates the browser + injects X-Auth-Request-* so
# panoscope can scope its view to the viewer).

# --- OIDC provider (site Hydra) ---
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ panoscope_oauth2_proxy_oidc_issuer_url }}
OAUTH2_PROXY_CLIENT_ID={{ panoscope_oidc_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ panoscope_oauth2_proxy_client_secret }}

# `groups` is the load-bearing scope: without it the JWT carries no groups
# claim, X-Auth-Request-Groups is empty, and every enforce-mode viewer
# lands on the Observer floor. `offline_access` enables silent session
# refresh at the COOKIE_REFRESH boundary (same rationale as
# oauth2-proxy-dashboard).
OAUTH2_PROXY_SCOPE={{ panoscope_oidc_scope }}

# --- Authorization: any authenticated identity passes the DOOR; the app
#     differentiates per ADR 1073 viewer tiers (that is the point — a
#     front-door 403 can't express "show this viewer their slice"). No
#     OAUTH2_PROXY_ALLOWED_GROUPS on purpose. ---
OAUTH2_PROXY_EMAIL_DOMAINS=*

# --- Cookie / session ---
OAUTH2_PROXY_COOKIE_SECRET={{ panoscope_oauth2_proxy_cookie_secret }}
OAUTH2_PROXY_COOKIE_DOMAINS={{ panoscope_hostname }}
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=8h

# --- Listener / routing ---
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_WHITELIST_DOMAINS={{ panoscope_hostname }}
OAUTH2_PROXY_REDIRECT_URL={{ panoscope_oidc_redirect_uri }}

# --- Upstream ---
OAUTH2_PROXY_UPSTREAMS=http://panoscope:8080

# --- Identity headers downstream (the whole reason this sidecar exists
#     for panoscope): the groups claim feeds src/viewer.rs's ViewerScope.
#     PASS_USER_HEADERS injects it on the UPSTREAM request as X-Forwarded-Groups
#     — the header oauth2-proxy STRIPS from client input and sets from the
#     validated session, so it is the unforgeable one viewer.rs trusts.
#     SET_XAUTHREQUEST stays true only for the /oauth2/auth RESPONSE path
#     (nginx-style consumers); viewer.rs must NOT read X-Auth-Request-* — those
#     are NOT stripped from client input in reverse-proxy mode, so trusting them
#     is forgeable. ---
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=false

# --- Skip provider-button page; jump straight to Hydra. ---
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

# --- Logging ---
OAUTH2_PROXY_REQUEST_LOGGING=true
OAUTH2_PROXY_AUTH_LOGGING=true
OAUTH2_PROXY_STANDARD_LOGGING=true
# Parallel login flows (a page and its favicon/XHRs racing through
# /oauth2/start together) each mint a CSRF cookie; without per-request
# cookies the later flow overwrites the earlier one's and the first
# callback 403s ("CSRF token mismatch, potential attack") even though
# authentication succeeded.
OAUTH2_PROXY_COOKIE_CSRF_PER_REQUEST=true
OAUTH2_PROXY_COOKIE_CSRF_EXPIRE=15m

# API_ROUTES + SKIP_AUTH_ROUTES — the other half of the line above.
#
# Per-request CSRF is right for a page and its XHRs racing through /oauth2/start
# once. It is a lockout when the page POLLS, because every poll made with an
# invalid session mints another 15-minute cookie and nobody ever completes the
# flow to clear it. A polling surface can produce a thousand login-initiations in
# one hour, hundreds of live CSRF cookies per 15-minute window. That buries a
# default nginx/Traefik header buffer and the operator gets
# `400 Request Header Or Cookie Too Large` with no way back except clearing
# cookies by hand.
#
# api_routes: return 401 rather than starting an OIDC flow, so a polling XHR or a
# dropped websocket fails like an XHR should and mints nothing. Interactive
# navigation still redirects to login normally.
OAUTH2_PROXY_API_ROUTES=^/(ws|api/)

# skip_auth_routes: /healthz is a container healthcheck. Gating it behind OIDC
# bought nothing — the prober has no cookie jar and no way to log in, so every
# probe was a guaranteed login-initiation. 240/hour of the count above was the
# healthcheck arguing with the auth proxy about credentials it can never have.
OAUTH2_PROXY_SKIP_AUTH_ROUTES=^/healthz$

# SESSION_COOKIE_MINIMAL — F-310.
#
# With no session store configured oauth2-proxy defaults to `cookie` and packs
# the WHOLE session into it: id_token + access_token + refresh_token, plus the
# groups claim the fence gates on. That exceeds the browser's per-cookie limit,
# the cookie is dropped, and the session evaporates a minute or two after a
# successful login — every refresh re-authenticates. oauth2-proxy logs NO
# warning for this: it warns when it SPLITS a cookie, never when the browser
# then declines to keep it, so the failure is invisible server-side.
#
# Without this a session with an 8 h expiry re-authenticates within minutes;
# with it, dozens of authenticated requests need only a login or two.
#
# `minimal` keeps email + user + groups and drops the three tokens. Verified
# compatible with SET_XAUTHREQUEST (tested against v7.6.0: the proxy starts and
# validates) — the X-Auth-Request-* headers are built from session fields, not
# from the tokens, so in-app group scoping is unaffected.
#
# COOKIE_REFRESH is REMOVED where it was set: it is mutually exclusive with
# minimal, because a refresh needs the refresh token minimal does not keep.
# Consequence stated rather than discovered — the session now lives to
# COOKIE_EXPIRE instead of being silently renewed, and Kratos's 24 h SSO makes
# the eventual re-auth a redirect, not a password prompt.
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true
