# Generated by the panoscope Ansible role — do not edit on host.
# Rendered to {{ panoscope_traefik_dynamic_dir }}/{{ panoscope_traefik_dynamic_filename }}.
#
# Matches the demogame pattern: file-provider router on Traefik,
# upstream addressed by Docker network alias on the `mgmt` network,
# Let's Encrypt cert via the `le` resolver. Filename intentionally
# distinct from the mgmt + demogame route files so a panoscope
# redeploy can't stomp on neighboring routes.
#
# RESPONSE COMPRESSION. panoscope is the one surface that queries on
# request (ADR 1123) and its frontend polls /api/snapshot on a
# tier-gated cadence (LIVE 1500 ms / SLOW 3000 ms), so an open tab is a
# standing load for as long as it is open: one browser tab can pull
# tens of MB in ten minutes. The payload is JSON and compresses ~10:1,
# so it must not travel uncompressed. The fix is the universal `goat-compress` middleware
# attached at the websecure ENTRYPOINT, not a route-local one: see
# docs/design/surface-overload-protection.md §4. Nothing about
# compression appears in this file, deliberately — a per-route copy
# would drift from the shared definition.

http:
  routers:
    {{ panoscope_traefik_router_name }}:
      rule: "Host(`{{ panoscope_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ panoscope_traefik_router_name }}
{% if (panoscope_traefik_mesh_only_middleware | default('') | length > 0) or (panoscope_traefik_ratelimit_middleware | default('') | length > 0) %}
      middlewares:
{% if panoscope_traefik_mesh_only_middleware | default('') | length > 0 %}
        # Mesh-only gating — middleware defined in the mgmt route file.
        - "{{ panoscope_traefik_mesh_only_middleware }}"
{% endif %}
{% if panoscope_traefik_ratelimit_middleware | default('') | length > 0 %}
        # Browsing rate ceiling, 50 r/s per source peer — `goat-ratelimit`
        # from the mgmt route file, attached per router (the
        # entrypoint keeps only the 3000 r/s control-plane ceiling). See
        # docs/design/surface-overload-protection.md §3.1.
        - "{{ panoscope_traefik_ratelimit_middleware }}"
{% endif %}
{% endif %}
      tls:
        certResolver: {{ panoscope_traefik_cert_resolver }}

  services:
    {{ panoscope_traefik_router_name }}:
      loadBalancer:
        servers:
{% if panoscope_oauth2_proxy_enabled %}
          # ADR 1073: route through the viewer-identity sidecar so every
          # request reaches panoscope with X-Auth-Request-* headers. The
          # mesh-only middleware above stays as defense-in-depth.
          - url: "http://oauth2-proxy-panoscope:4180"
{% else %}
          - url: "http://panoscope:8080"
{% endif %}
