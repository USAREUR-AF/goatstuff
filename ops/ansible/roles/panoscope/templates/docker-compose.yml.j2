# Generated by the panoscope Ansible role — do not edit by hand.
# Schema-of-record: the site compose in ops/compose/.
services:
  panoscope:
    image: "{{ panoscope_image }}"
    # Pin the manifest-list member to the host arch — without this
    # compose resolves the digest-pinned list to amd64 and crash-loops on
    # arm64 hosts.
    platform: "{{ panoscope_image_platform }}"
    container_name: panoscope
    restart: unless-stopped
{% if panoscope_mem_limit | default('') | length > 0 %}
    # Backstop, not a tuned limit — see panoscope_mem_limit in role defaults for
    # why the number is what it is and what to do if it is ever reached.
    mem_limit: "{{ panoscope_mem_limit }}"
{% endif %}
    networks:
      # `mgmt` — Traefik resolves panoscope:8080 over this network.
      - "{{ panoscope_traefik_network }}"
      # `zenoh_default` — panoscope reaches zenoh-router:7447 over this.
      - "{{ panoscope_zenoh_network }}"
    expose:
      - "8080"
    # On-host DNS override for portal.<site>.<zone>. Panoscope's schema
    # refresher hits the portal API every panoscope_portal_refresh_secs
    # seconds; Docker's embedded resolver can't see mesh CoreDNS on :5353,
    # so the public hostname has to be statically pinned to the
    # mgmt-host's mesh IP. Closes F-126 for the panoscope shape.
    extra_hosts:
      - "{{ panoscope_portal_host_entry }}"
    env_file:
      - .env
    volumes:
      # Derived-state snapshot. Must OUTLIVE the container: its whole
      # purpose is that a restart reloads what the last run derived instead of
      # re-walking 136,830 audit objects. An anonymous volume or a container
      # path would be discarded on every recreate, which is exactly the case
      # this is meant to remove — so it is an explicit host bind.
      - "{{ panoscope_state_dir }}:/var/lib/panoscope"
{% if panoscope_zenoh_mtls_enabled %}
      - "{{ panoscope_zenoh_client_cert }}:/etc/panoscope/zenoh-client-cert.pem:ro"
      - "{{ panoscope_zenoh_client_key }}:/etc/panoscope/zenoh-client-key.pem:ro"
      - "{{ panoscope_nova_ca_root }}:/etc/panoscope/nova-ca-root.pem:ro"
{% endif %}
    # No Traefik docker labels — the live deploy uses file-provider
    # routing via /etc/traefik/dynamic/{{ panoscope_traefik_dynamic_filename }}.
    labels:
      - "traefik.enable=false"
{% if panoscope_oauth2_proxy_enabled %}

  # ADR 1073 viewer-identity sidecar: authenticates the browser against the
  # site Hydra and forwards X-Auth-Request-Email/-Groups to panoscope so
  # the app can scope its view. Traefik routes to :4180 when enabled (see
  # traefik-panoscope.yml.j2); panoscope itself stays un-exposed.
  oauth2-proxy-panoscope:
    image: "{{ panoscope_oauth2_proxy_image }}"
    container_name: oauth2-proxy-panoscope
    restart: unless-stopped
    networks:
      - "{{ panoscope_traefik_network }}"
    expose:
      - "4180"
    extra_hosts:
      # F-126: the container's embedded resolver can't reach mesh CoreDNS
      # on :5353, so the OIDC issuer hostname pins to the mgmt-host mesh IP.
      - "{{ panoscope_oauth2_proxy_oidc_host_entry }}"
    env_file:
      - oauth2-proxy-panoscope.env
    labels:
      - "traefik.enable=false"
{% endif %}

networks:
  "{{ panoscope_traefik_network }}":
    external: true
    name: "{{ panoscope_traefik_network }}"
  "{{ panoscope_zenoh_network }}":
    external: true
    name: "{{ panoscope_zenoh_network }}"
