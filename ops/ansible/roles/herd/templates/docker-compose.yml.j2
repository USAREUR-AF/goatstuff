# Rendered by ops/ansible/roles/herd/ — DO NOT EDIT ON HOST.
#
# Every service binds to the docker network only. Nothing publishes a host port:
# Traefik reaches the fence over {{ herd_traefik_network }}, and the fence is the
# only way in. A published port here would be a way around the group gate AND
# the entitlement gate at once.
services:
  herd-postgres:
    image: "{{ herd_postgres_image }}"
    container_name: herd-postgres
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped
    environment:
      POSTGRES_DB: "{{ herd_db_name }}"
      POSTGRES_USER: "{{ herd_db_user }}"
      POSTGRES_PASSWORD: "{{ herd_db_password }}"
    volumes:
      - herd-pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ herd_db_user }} -d {{ herd_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 12
    labels:
      - "traefik.enable=false"

  # The remote-desktop protocol translator. Reachable only from herd.
  herd-guacd:
    image: "{{ herd_guacd_image }}"
    container_name: herd-guacd
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped
    labels:
      - "traefik.enable=false"

  herd:
    image: "{{ herd_image }}"
    container_name: herd
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: 1280M
    restart: unless-stopped
    depends_on:
      herd-postgres:
        condition: service_healthy
    env_file:
      - "{{ herd_dir }}/herd.env"
    volumes:
      # Herd's OWN portal service key — a machine credential, mounted read-only.
      - "{{ herd_portal_key_file }}:{{ herd_portal_key_file }}:ro"
    networks:
      - default
      - "{{ herd_traefik_network }}"
    labels:
      - "traefik.enable=false"

{% if herd_oauth2_proxy_enabled %}
  oauth2-proxy-herd:
    image: "{{ herd_oauth2_proxy_image }}"
    container_name: oauth2-proxy-herd
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped
    depends_on:
      - herd
    # OIDC discovery hits the issuer's mesh-DNS name, which the container's
    # embedded resolver (127.0.0.11) cannot answer — pin it to the mesh IP the
    # way every other oauth2-proxy on the host does. Without this
    # the proxy exits fatal on "no such host" and restart-loops forever while
    # the service behind it is perfectly healthy.
    extra_hosts:
      - "{{ herd_oauth2_proxy_oidc_host_entry }}"
    env_file:
      - "{{ herd_dir }}/oauth2-proxy-herd.env"
    networks:
      - default
      - "{{ herd_traefik_network }}"
    labels:
      - "traefik.enable=false"
{% endif %}

volumes:
  herd-pgdata:

networks:
  default:
  "{{ herd_traefik_network }}":
    external: true
    name: "{{ herd_traefik_network }}"
