# Rendered by ops/ansible/roles/herd/ — DO NOT EDIT ON HOST.
# Mode 0600 root:root. Mirrors oauth2-proxy-netvis / -id-console (ADR 0860).
#
# PASS_USER_HEADERS is load-bearing, not cosmetic: herd reads
# X-Forwarded-{Email,User,Preferred-Username,Groups} and NOTHING else.
# X-Forwarded-Preferred-Username in particular carries the identity ID that the
# ADR 1131 entitlement lookup keys on — without it herd falls back to the user
# and email candidates, and a wrong candidate cannot grant, only deny.

OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ herd_oauth2_proxy_oidc_issuer_url }}
OAUTH2_PROXY_CLIENT_ID={{ herd_oauth2_proxy_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ herd_oauth2_proxy_client_secret }}

OAUTH2_PROXY_SCOPE=openid profile email groups offline_access

OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_ALLOWED_GROUPS={{ herd_oauth2_proxy_allowed_groups }}

OAUTH2_PROXY_COOKIE_SECRET={{ herd_oauth2_proxy_cookie_secret }}
OAUTH2_PROXY_COOKIE_DOMAINS={{ herd_hostname }}
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=8h
# See the netvis role for the measurement behind this: without `minimal`, the
# whole session (three tokens + groups) exceeds the per-cookie limit, the cookie
# is dropped, and an 8h session dies within ~90s. COOKIE_REFRESH is deliberately
# absent — it is mutually exclusive with minimal.
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true

OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_WHITELIST_DOMAINS={{ herd_hostname }}
OAUTH2_PROXY_REDIRECT_URL=https://{{ herd_hostname }}/oauth2/callback

OAUTH2_PROXY_UPSTREAMS=http://herd:3000

OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=false
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=false

OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_REQUEST_LOGGING=true
