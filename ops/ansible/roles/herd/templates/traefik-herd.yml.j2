# SPDX-License-Identifier: Apache-2.0
# Generated by the herd Ansible role — do not edit on host.
# Rendered to {{ herd_traefik_dynamic_dir }}/{{ herd_traefik_dynamic_filename }}.
#
# Fence chain:
#   Traefik (mesh-only middleware, defense in depth)
#     → oauth2-proxy-herd:4180 (PLATFORM-ADMIN group gate)
#       → herd:3000 (its own fail-closed X-Forwarded-* read, F-244)
#         → the network_admin ENTITLEMENT check, per session (ADR 1131)
#
# No bearer bypass router. Herd opens shells on transport gear; a route that
# skipped the group gate for anything carrying an Authorization header would be
# a second door onto that, and there is no caller asking for one.
http:
  routers:
    {{ herd_traefik_router_name }}:
      rule: "Host(`{{ herd_hostname }}`)"
      priority: 10
      entryPoints:
        - websecure
      service: {{ herd_traefik_router_name }}
{% if (herd_traefik_mesh_only_middleware | default('') | length > 0) or (herd_traefik_ratelimit_middleware | default('') | length > 0) %}
      middlewares:
{% if herd_traefik_mesh_only_middleware | default('') | length > 0 %}
        - "{{ herd_traefik_mesh_only_middleware }}"
{% endif %}
{% if herd_traefik_ratelimit_middleware | default('') | length > 0 %}
        # Browsing rate ceiling, 50 r/s per source peer — `goat-ratelimit`
        # from mgmt-dynamic.yml.j2, attached per router (the
        # entrypoint keeps only the 3000 r/s ceiling). See
        # docs/design/surface-overload-protection.md §3.1.
        - "{{ herd_traefik_ratelimit_middleware }}"
{% endif %}
{% endif %}
      tls:
        certResolver: {{ herd_traefik_cert_resolver }}

{% if herd_block_unscoped_routes %}
    # A HIGHER-priority router that terminates the two paths ADR 1131 says must
    # not exist, before they reach the application at all.
    #
    # ADR 1131 §1: herd "declares nothing and drives nothing", which settles the
    # pulled-convergence question (ADR 1109 D2) "by construction rather than by
    # discipline". The image deployed  is the full upstream product
    # and ships /api/shepherd/exec and /api/shepherd/apply — remote command
    # execution and configuration apply against nodes — plus an on-demand active
    # scan at /api/network-sweep/run.
    #
    # Blocking them here restores the ratified posture without waiting on an
    # image rebuild, and without pretending the code has been scoped: everything
    # is still IN the artifact, it simply cannot be reached through the door.
    # Read paths are untouched, so the sweep findings views and every page
    # continue to work.
    #
    # This is a stopgap with a named exit. Either the code is scoped to match the
    # ADR, or the ADR is amended to permit these routes — tracked as the queued
    # `herd-scope-code-to-adr-1131`. Set herd_block_unscoped_routes: false to
    # lift it deliberately.
    {{ herd_traefik_router_name }}-unscoped-deny:
      rule: "Host(`{{ herd_hostname }}`) && (PathPrefix(`/api/shepherd`) || Path(`/api/network-sweep/run`))"
      priority: 100
      entryPoints:
        - websecure
      service: {{ herd_traefik_router_name }}
      middlewares:
        - "{{ herd_traefik_router_name }}-deny"
      tls:
        certResolver: {{ herd_traefik_cert_resolver }}
{% endif %}

  middlewares:
{% if herd_block_unscoped_routes %}
    # Denial by an allow-list that admits an address nobody can hold: 192.0.2.1
    # is TEST-NET-1 (RFC 5737), reserved for documentation and never routed. Every
    # real client falls outside it and gets a 403 before the request is proxied.
    #
    # An ipAllowList is used rather than a plugin so the deny needs no external
    # code and cannot fail open if a plugin is unavailable. The service is still
    # named on the router because Traefik requires one; it is never reached.
    {{ herd_traefik_router_name }}-deny:
      ipAllowList:
        sourceRange:
          - "192.0.2.1/32"
{% endif %}

  services:
    {{ herd_traefik_router_name }}:
      loadBalancer:
        servers:
{% if herd_oauth2_proxy_enabled %}
          - url: "http://oauth2-proxy-herd:4180"
{% else %}
          - url: "http://herd:3000"
{% endif %}
