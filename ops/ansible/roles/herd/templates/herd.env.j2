# Rendered by ops/ansible/roles/herd/ — DO NOT EDIT ON HOST.
# Mode 0600 root:root. Generated against herd's lib/config.ts surface, so
# config and deploy cannot drift.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://{{ herd_db_user }}:{{ herd_db_password }}@herd-postgres:5432/{{ herd_db_name }}

# --- identity: the goat Ory human plane (ADR 1131) ---
# Only PLATFORM-ADMIN is mapped. NETWORK-ADMIN was rejected as a goat Ory group
# by ADR 1113, HERD-ADMIN is replaced by the entitlement, and ADMINS is the
# F-213 conflation goat's own enum guard refuses.
IDENTITY_PROVIDER={{ herd_identity_provider }}
TRUST_PROXY={{ herd_trust_proxy | lower }}

# --- the entitlement gate: the second of the two ADR 1131 gates ---
ENTITLEMENT_REQUIRED={{ herd_entitlement_required | lower }}
ADMIN_OVERRIDE_SECRET={{ herd_admin_override_secret }}
GOAT_PORTAL_URL={{ herd_portal_url }}
GOAT_PORTAL_KEY_FILE={{ herd_portal_key_file }}

# --- the node-class projection: refuse anything that is not bearer gear ---
GOAT_ENFORCE_NODE_CLASS={{ herd_enforce_node_class | lower }}
GOAT_REGISTRY_SYNC_INTERVAL_MS={{ herd_registry_sync_interval_ms }}
GOAT_REGISTRY_MAX_AGE_MS={{ herd_registry_max_age_ms }}

# --- ssh posture ---
# There is no password knob. The first-hop password was removed from the schema,
# the environment and the vault overlay; hop one is Netbird SSO or a key.
SSH_HOSTKEY_POLICY={{ herd_ssh_hostkey_policy }}
CREDENTIAL_RESOLVER={{ herd_credential_resolver }}

# Fabric coupling, forced OFF. The app enables its Zenoh tracks subscription
# UNLESS this reads exactly "false", and defaults the key to "**". See the
# defaults file for why this is passed explicitly rather than left unset.
ZENOH_TRACKS_ENABLED={{ herd_zenoh_tracks_enabled | lower }}
ZENOH_REST_URL={{ herd_zenoh_rest_url }}
ZENOH_TRACKS_KEY={{ herd_zenoh_tracks_key }}
KMS_SECRET_PREFIX={{ herd_kms_secret_prefix }}
