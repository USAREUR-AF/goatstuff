# Rendered by the goat-feeds role. The sign-in fence in front of goat-feeds.
services:
  oauth2-proxy:
    image: "{{ goat_feeds_oauth2_proxy_image }}"
    container_name: oauth2-proxy-goat-feeds
    restart: unless-stopped
    network_mode: host
    extra_hosts:
      - "{{ goat_feeds_oidc_host_entry }}"
    env_file:
      - oauth2-proxy.env
    mem_limit: 128m
    cpus: 0.25
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
