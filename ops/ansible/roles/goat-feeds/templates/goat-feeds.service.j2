# Rendered by the goat-feeds role (ADR 1259). Do not edit on the host.
[Unit]
Description=goat-feeds: approved delivery of fabric topics to mesh systems
After=network-online.target docker.service
Wants=network-online.target

[Service]
User={{ goat_feeds_user }}
Group={{ goat_feeds_user }}
{% if goat_feeds_declared_dir | length > 0 %}
# Declared links (ADR 1260): read each link's status line from the journal, read-only,
# until every link publishes its own health record on the fabric.
SupplementaryGroups=systemd-journal
{% endif %}
ExecStart={{ goat_feeds_dir }}/goat-feeds -config {{ goat_feeds_etc }}/config.json
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths={{ goat_feeds_etc }} /etc/goat-xf /etc/goat-processors/tls /opt/goat-xf
# ping for the destination check
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
