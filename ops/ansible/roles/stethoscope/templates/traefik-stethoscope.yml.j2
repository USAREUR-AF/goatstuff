# Generated by the stethoscope Ansible role — do not edit on host.
# Rendered to {{ stethoscope_traefik_dynamic_dir }}/{{ stethoscope_traefik_dynamic_filename }}.
#
# Matches the demogame / panoscope pattern: file-provider
# router on Traefik, upstream addressed by Docker network alias on the
# `mgmt` network, Let's Encrypt cert via the `le` resolver. Filename
# intentionally distinct from neighbors so a stethoscope redeploy
# can't stomp on adjacent routes.

http:
  routers:
    {{ stethoscope_traefik_router_name }}:
      rule: "Host(`{{ stethoscope_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ stethoscope_traefik_router_name }}
{% if (stethoscope_traefik_mesh_only_middleware | default('') | length > 0) or (stethoscope_traefik_ratelimit_middleware | default('') | length > 0) %}
      middlewares:
{% if stethoscope_traefik_mesh_only_middleware | default('') | length > 0 %}
        # Mesh-only gating — middleware defined in mgmt-dynamic.yml.j2.
        - "{{ stethoscope_traefik_mesh_only_middleware }}"
{% endif %}
{% if stethoscope_traefik_ratelimit_middleware | default('') | length > 0 %}
        # Browsing rate ceiling, 50 r/s per source peer — `goat-ratelimit`
        # from mgmt-dynamic.yml.j2, attached per router (the
        # entrypoint keeps only the 3000 r/s ceiling). See
        # docs/design/surface-overload-protection.md §3.1.
        - "{{ stethoscope_traefik_ratelimit_middleware }}"
{% endif %}
{% endif %}
      tls:
        certResolver: {{ stethoscope_traefik_cert_resolver }}

  services:
    {{ stethoscope_traefik_router_name }}:
      loadBalancer:
        servers:
          - url: "http://stethoscope:8080"
