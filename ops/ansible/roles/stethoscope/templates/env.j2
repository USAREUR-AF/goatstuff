STETHOSCOPE_BIND={{ stethoscope_bind }}
STETHOSCOPE_SITE_LABEL={{ stethoscope_site_label }}

STETHOSCOPE_PORTAL_URL={{ stethoscope_portal_url }}
STETHOSCOPE_PORTAL_API_KEY={{ stethoscope_portal_api_key }}

STETHOSCOPE_AUDIT_ENABLED={{ stethoscope_audit_enabled | string | lower }}
STETHOSCOPE_AUDIT_ENDPOINT={{ stethoscope_audit_endpoint }}
STETHOSCOPE_AUDIT_REGION={{ stethoscope_audit_region }}
STETHOSCOPE_AUDIT_BUCKET={{ stethoscope_audit_bucket }}
STETHOSCOPE_AUDIT_KEY_PREFIX={{ stethoscope_audit_key_prefix }}
STETHOSCOPE_AUDIT_ACCESS_KEY={{ stethoscope_audit_access_key }}
STETHOSCOPE_AUDIT_SECRET_KEY={{ stethoscope_audit_secret_key }}
STETHOSCOPE_AUDIT_REQUEST_TIMEOUT_S={{ stethoscope_audit_request_timeout_s }}
STETHOSCOPE_AUDIT_MAX_OBJECTS={{ stethoscope_audit_max_objects }}

RUST_LOG={{ stethoscope_rust_log }}

{% if stethoscope_sibling_panoscope_url | default('') %}
STETHOSCOPE_SIBLING_PANOSCOPE_URL={{ stethoscope_sibling_panoscope_url }}
{% endif %}
{% if stethoscope_sibling_flashlight_url | default('') %}
STETHOSCOPE_SIBLING_FLASHLIGHT_URL={{ stethoscope_sibling_flashlight_url }}
{% endif %}
{#
  Display-only lexicon (docs/design/portal-lexicon.md). Sourced from the
  SAME portal_lex_org group_var the portal + panoscope + flashlight read,
  so the participant noun never drifts across surfaces. Unset (nova-a) → no
  line → stethoscope keeps its byte-stable "vendor" default. Render-time
  only — kind value / ?vendor= param / key shape untouched.
#}
{% set _lex_org = stethoscope_lex_org | default(portal_lex_org | default('')) %}
{% if _lex_org %}
STETHOSCOPE_LEX_ORG={{ _lex_org }}
{% endif %}
