# Generated by the stethoscope Ansible role — do not edit by hand.
# Block 90 Phase B per docs/design/stethoscope.md.
services:
  stethoscope:
    image: "{{ stethoscope_image }}"
    container_name: stethoscope
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped
    networks:
      # `mgmt` — Traefik resolves stethoscope:8080 over this network.
      - "{{ stethoscope_traefik_network }}"
    expose:
      - "8080"
    # On-host DNS override for portal.<site>.<zone>. The portal
    # hostname is in mesh-DNS only; Docker's embedded resolver can't
    # see CoreDNS on :5353, so the public name is statically pinned
    # to the mgmt-host's mesh IP. Same F-126 shape as panoscope.
    extra_hosts:
      - "{{ stethoscope_portal_host_entry }}"
    env_file:
      - .env
    # No Traefik docker labels — the live deploy uses file-provider
    # routing via /etc/traefik/dynamic/{{ stethoscope_traefik_dynamic_filename }}.
    labels:
      - "traefik.enable=false"

networks:
  "{{ stethoscope_traefik_network }}":
    external: true
    name: "{{ stethoscope_traefik_network }}"
