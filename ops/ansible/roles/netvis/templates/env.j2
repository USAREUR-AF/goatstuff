# Generated by the netvis Ansible role — do not edit by hand.
NETVIS_LISTEN=0.0.0.0:9760
NETVIS_SITE_LABEL={{ netvis_site_label }}
NETVIS_NETBIRD_URL={{ netvis_netbird_url }}
NETVIS_NETBIRD_TOKEN={{ netvis_netbird_token }}
# The binary's own fence, behind the proxy's. Two gates on purpose: the proxy
# can be misconfigured, and this one fails closed when the groups header is
# absent rather than serving the whole ACL to whoever reaches the port.
NETVIS_RBAC_MODE={{ netvis_rbac_mode }}
NETVIS_RBAC_GROUPS={{ netvis_rbac_groups }}
RUST_LOG=info
# The goatnet's ACL declaration and rule intents, mounted by the role.
NETVIS_ACL_DECLARATION_DIR=/etc/netvis/declaration
NETVIS_RULE_INTENTS_FILE=/etc/netvis/declaration/rule-intents.yaml

# --- ownership lens (peer -> the person responsible) ------------------------
# Resolves a machine to its custodian via the portal's access graph
# (POST /api/access/peers, docs/design/peer-identity-resolution.md Option B).
# BOTH must be set or the lens reports `unread` on every peer — which is the
# honest value for "we did not look" and is deliberately NOT a blank.
# netvis holds its OWN portal key, not microscope's: a shared credential means
# revoking one surface silently revokes the other.
NETVIS_PORTAL_URL={{ netvis_portal_url }}
NETVIS_PORTAL_API_KEY={{ netvis_portal_api_key }}
# Where a resolved person deep-links to. Server-supplied so the browser never
# has to guess the console host from its own hostname.
NETVIS_ID_CONSOLE_URL={{ netvis_id_console_url }}
