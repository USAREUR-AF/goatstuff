# Generated by the netvis Ansible role — do not edit on host.
# Rendered to {{ netvis_traefik_dynamic_dir }}/{{ netvis_traefik_dynamic_filename }}.
#
# Fence chain:
#   Traefik (mesh-only middleware, defense in depth)
#     → oauth2-proxy-netvis:4180 (identity-admin group gate)
#       → netvis:9760 (its own fence, fail-closed)
#
# No CLI bearer bypass, unlike microscope. netvis has no CLI lens and adding a
# router that skips the group gate for anything carrying an Authorization
# header would be a second door onto the entire ACL for no current caller.
http:
  routers:
    {{ netvis_traefik_router_name }}:
      rule: "Host(`{{ netvis_hostname }}`)"
      priority: 10
      entryPoints:
        - websecure
      service: {{ netvis_traefik_router_name }}
{% if (netvis_traefik_mesh_only_middleware | default('') | length > 0) or (netvis_traefik_ratelimit_middleware | default('') | length > 0) %}
      middlewares:
{% if netvis_traefik_mesh_only_middleware | default('') | length > 0 %}
        - "{{ netvis_traefik_mesh_only_middleware }}"
{% endif %}
{% if netvis_traefik_ratelimit_middleware | default('') | length > 0 %}
        # Browsing rate ceiling, 50 r/s per source peer — `goat-ratelimit`
        # from mgmt-dynamic.yml.j2, attached per router (the
        # entrypoint keeps only the 3000 r/s ceiling). See
        # docs/design/surface-overload-protection.md §3.1.
        - "{{ netvis_traefik_ratelimit_middleware }}"
{% endif %}
{% endif %}
      tls:
        certResolver: {{ netvis_traefik_cert_resolver }}

  services:
    {{ netvis_traefik_router_name }}:
      loadBalancer:
        servers:
{% if netvis_oauth2_proxy_enabled %}
          - url: "http://oauth2-proxy-netvis:4180"
{% else %}
          - url: "http://netvis:9760"
{% endif %}
