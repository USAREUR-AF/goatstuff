# Generated by the netvis Ansible role — do not edit by hand.
# Fence chain: Traefik (mesh-only) → oauth2-proxy-netvis:4180 → netvis:9760.
services:
  netvis:
    image: "{{ netvis_image }}"
    container_name: netvis
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped
    networks:
      - "{{ netvis_traefik_network }}"
    expose:
      - "9760"
{% set _nb_pin = netvis_netbird_url | length > 0 and netvis_netbird_host_addr | length > 0 %}
{% if netvis_portal_host_entry | default('') | length > 0 or _nb_pin %}
    extra_hosts:
{% if netvis_portal_host_entry | default('') | length > 0 %}
      # The ownership lens dials the portal by its mesh hostname, which does NOT
      # resolve from inside a container on the mgmt network. `host-gateway`, never
      # a mesh IP: mesh IPs are not stable across re-enrollment, and baking one in
      # is what 403'd every login on this goatnet when host A moved.
      - "{{ netvis_portal_host_entry }}"
{% endif %}
{% if _nb_pin %}
      # NetBird management API name -> the host's traefik (netvis_netbird_host_addr).
      - "{{ netvis_netbird_url | urlsplit('hostname') }}:{{ netvis_netbird_host_addr }}"
{% endif %}
{% endif %}
    env_file:
      - .env
    volumes:
      # The goatnet's ACL declaration and rule intents (the role places them).
      - ./declaration:/etc/netvis/declaration:ro
    labels:
      - "traefik.enable=false"

{% if netvis_oauth2_proxy_enabled %}
  oauth2-proxy-netvis:
    image: "{{ netvis_oauth2_proxy_image }}"
    container_name: oauth2-proxy-netvis
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped
    networks:
      - "{{ netvis_traefik_network }}"
    expose:
      - "4180"
    # OIDC discovery hits the issuer's mesh-DNS name — pin it.
    extra_hosts:
      - "{{ netvis_oauth2_proxy_oidc_host_entry }}"
    env_file:
      - oauth2-proxy-netvis.env
    labels:
      - "traefik.enable=false"
{% endif %}

networks:
  "{{ netvis_traefik_network }}":
    external: true
    name: "{{ netvis_traefik_network }}"
