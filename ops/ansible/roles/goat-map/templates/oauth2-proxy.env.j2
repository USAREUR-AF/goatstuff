# Rendered by the goat-map role. Holds secrets: mode 0600, never committed.
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ goat_map_oidc_issuer_url }}
OAUTH2_PROXY_CLIENT_ID={{ goat_map_oauth2_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ goat_map_oauth2_client_secret }}
OAUTH2_PROXY_SCOPE=openid profile email groups
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_ALLOWED_GROUPS={{ goat_map_oauth2_allowed_groups }}
OAUTH2_PROXY_COOKIE_SECRET={{ goat_map_oauth2_cookie_secret }}
OAUTH2_PROXY_COOKIE_DOMAINS={{ goat_map_hostname }}
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=8h
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true
OAUTH2_PROXY_COOKIE_REFRESH=0
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_WHITELIST_DOMAINS={{ goat_map_hostname }}
OAUTH2_PROXY_REDIRECT_URL=https://{{ goat_map_hostname }}/oauth2/callback
OAUTH2_PROXY_UPSTREAMS=http://{{ goat_map_container }}:8080
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=false
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=false
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_SKIP_AUTH_ROUTES=^/healthz$
OAUTH2_PROXY_REQUEST_LOGGING=true
