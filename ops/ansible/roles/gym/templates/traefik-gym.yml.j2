# Generated by the gym Ansible role — do not edit on host.
# Rendered to {{ gym_traefik_dynamic_dir }}/{{ gym_traefik_dynamic_filename }}.
#
# File-provider router: upstream addressed by Docker network alias on the
# `mgmt` network, Let's Encrypt cert via the `le` resolver, mesh-only gating
# via the shared middleware. Distinct filename + router name so a gym
# redeploy cannot stomp the neighbouring routes.

http:
  routers:
    {{ gym_traefik_router_name }}:
      rule: "Host(`{{ gym_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ gym_traefik_router_name }}
{% if gym_traefik_mesh_only_middleware | default('') | length > 0 %}
      middlewares:
        # Mesh-only gating and nothing more. The gym carries no credentials
        # and every drill is safe to fail; an oauth2 fence here would hide
        # the training from the people it is written for.
        - "{{ gym_traefik_mesh_only_middleware }}"
{% endif %}
{% if gym_traefik_cert_resolver | default('') | length > 0 %}
      tls:
        certResolver: {{ gym_traefik_cert_resolver }}
{% else %}
      tls: {}
{% endif %}

  services:
    {{ gym_traefik_router_name }}:
      loadBalancer:
        servers:
          - url: "http://{{ gym_container_name }}:{{ gym_internal_port }}"
