# Generated by the gym Ansible role — do not edit on host.
server {
    listen {{ gym_internal_port }};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Machine-readable registry, for anything that wants the lanes without
    # scraping HTML (the CLI, a future `goat gym` subcommand, a dashboard).
    location = /gym.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        try_files /gym.json =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
