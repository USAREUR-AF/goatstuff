# SPDX-License-Identifier: Apache-2.0
# Generated by the gym Ansible role — do not edit on host.
# nginx:alpine serving {{ gym_www_dir }} (the rendered goat gym site)
# read-only. Traefik routes to it via the file-provider config in
# {{ gym_traefik_dynamic_dir }}/{{ gym_traefik_dynamic_filename }}.
services:
  {{ gym_container_name }}:
    image: "{{ gym_image }}"
    container_name: "{{ gym_container_name }}"
    restart: unless-stopped
    networks:
      # `mgmt` — Traefik resolves {{ gym_container_name }}:{{ gym_internal_port }} over this network.
      - "{{ gym_traefik_network }}"
    expose:
      - "{{ gym_internal_port }}"
    volumes:
      # Directory bind (stable inode, updated in place by the role).
      - "{{ gym_www_dir }}:/usr/share/nginx/html:ro"
      # Single-FILE bind: pinned at create time. The role checksums the
      # container's copy against the host's and recreates on mismatch.
      - "{{ gym_compose_dir }}/nginx.conf:/etc/nginx/conf.d/default.conf:ro"
    # No Traefik docker labels — file-provider routing only.
    labels:
      - "traefik.enable=false"
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "3"

networks:
  "{{ gym_traefik_network }}":
    external: true
    name: "{{ gym_traefik_network }}"
