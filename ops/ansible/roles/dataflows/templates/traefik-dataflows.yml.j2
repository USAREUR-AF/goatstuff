# Generated by the dataflows Ansible role — do not edit on host.
# Rendered to {{ dataflows_traefik_dynamic_dir }}/{{ dataflows_traefik_dynamic_filename }}.
#
# Sibling-of-brief — same pattern: file-provider router on Traefik,
# upstream addressed by Docker network alias on the `mgmt` network,
# Let's Encrypt cert via the `le` resolver, mesh-only gating via the
# shared middleware. Filename intentionally distinct from mgmt.yml
# + demogame.yml + panoscope.yml + brief.yml so a
# dataflows redeploy can't stomp on neighboring routes.

http:
  routers:
    {{ dataflows_traefik_router_name }}:
      rule: "Host(`{{ dataflows_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ dataflows_traefik_router_name }}
{% if dataflows_traefik_mesh_only_middleware | default('') | length > 0 %}
      middlewares:
        # Mesh-only gating — middleware defined in mgmt-dynamic.yml.j2.
        # The static presentation carries no application-layer auth; this is the
        # whole auth surface.
        - "{{ dataflows_traefik_mesh_only_middleware }}"
{% endif %}
      tls:
        certResolver: {{ dataflows_traefik_cert_resolver }}

  services:
    {{ dataflows_traefik_router_name }}:
      loadBalancer:
        servers:
{% if dataflows_oauth2_proxy_enabled | default(false) | bool %}
          # Authenticated door (ADR 1073). Every request reaches dataflows through
          # the oauth2-proxy sidecar, so the person is known and Hydra records
          # one consent grant per visitor — which is what makes this surface
          # visible to microscope. The mesh-only middleware above stays as
          # defence in depth.
          - url: "http://oauth2-proxy-dataflows:4180"
{% else %}
          - url: "http://{{ dataflows_container_name }}:{{ dataflows_internal_port }}"
{% endif %}
