# Generated by the dataflows Ansible role — do not edit on host.
# Schema-of-record: ops/serve/dataflows/docker-compose.yml
# (the local-dev compose; this on-host compose uses image: instead of build:).
services:
  {{ dataflows_container_name }}:
    image: "{{ dataflows_image }}"
    container_name: "{{ dataflows_container_name }}"
    restart: unless-stopped
    networks:
      # `mgmt` — Traefik resolves {{ dataflows_container_name }}:80 over this network.
      - "{{ dataflows_traefik_network }}"
    expose:
      - "{{ dataflows_internal_port }}"
    # No Traefik docker labels — the live deploy uses file-provider
    # routing via /etc/traefik/dynamic/{{ dataflows_traefik_dynamic_filename }}.
    labels:
      - "traefik.enable=false"
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "3"

networks:
  "{{ dataflows_traefik_network }}":
    external: true
    name: "{{ dataflows_traefik_network }}"
