# Generated by the help-desk Ansible role — do not edit on host.
# Rendered to {{ help_desk_traefik_dynamic_dir }}/{{ help_desk_traefik_dynamic_filename }}.
#
# Mesh entry point for a help desk that runs on another peer (ADR 1176). The
# name resolves to this host through mesh CoreDNS; Traefik terminates TLS with
# the site's Let's Encrypt resolver and forwards to the authenticated door when
# it is on, or to the upstream peer directly when it is off. The mesh-only
# middleware stays on in both states as defence in depth.

http:
  routers:
    {{ help_desk_traefik_router_name }}:
      rule: "Host(`{{ help_desk_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ help_desk_traefik_router_name }}
{% if help_desk_traefik_mesh_only_middleware | default('') | length > 0 %}
      middlewares:
        - "{{ help_desk_traefik_mesh_only_middleware }}"
{% endif %}
      tls:
        certResolver: {{ help_desk_traefik_cert_resolver }}

  services:
    {{ help_desk_traefik_router_name }}:
      loadBalancer:
        servers:
{% if help_oauth2_proxy_enabled | default(false) | bool %}
          # Authenticated door (ADR 1163 / ADR 1176): the person is known to the
          # help desk as X-Forwarded-User / -Email / -Groups, and every visit is
          # a SurfaceVisitV1 from the door's request log.
          - url: "http://oauth2-proxy-help:4180"
{% else %}
          - url: "http://{{ help_desk_upstream_host }}:{{ help_desk_upstream_port }}"
{% endif %}
