# Generated by the flashlight Ansible role — do not edit on host.
# Rendered to {{ flashlight_traefik_dynamic_dir }}/{{ flashlight_traefik_dynamic_filename }}.
#
# Matches the panoscope pattern: file-provider router on Traefik,
# upstream addressed by Docker network alias on the `mgmt` network,
# Let's Encrypt cert via the `le` resolver. Filename distinct from
# neighboring routes so a flashlight redeploy can't stomp them.

http:
  routers:
    {{ flashlight_traefik_router_name }}:
      rule: "Host(`{{ flashlight_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ flashlight_traefik_router_name }}
{% if (flashlight_traefik_mesh_only_middleware | default('') | length > 0) or (flashlight_traefik_ratelimit_middleware | default('') | length > 0) %}
      middlewares:
{% if flashlight_traefik_mesh_only_middleware | default('') | length > 0 %}
        # Mesh-only gating — middleware defined in mgmt-dynamic.yml.j2.
        - "{{ flashlight_traefik_mesh_only_middleware }}"
{% endif %}
{% if flashlight_traefik_ratelimit_middleware | default('') | length > 0 %}
        # Browsing rate ceiling, 50 r/s per source peer — `goat-ratelimit`
        # from mgmt-dynamic.yml.j2, attached per router (the
        # entrypoint keeps only the 3000 r/s ceiling). See
        # docs/design/surface-overload-protection.md §3.1.
        - "{{ flashlight_traefik_ratelimit_middleware }}"
{% endif %}
{% endif %}
      tls:
        certResolver: {{ flashlight_traefik_cert_resolver }}

  services:
    {{ flashlight_traefik_router_name }}:
      loadBalancer:
        servers:
          - url: "http://flashlight:8080"
