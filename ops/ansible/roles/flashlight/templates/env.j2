# Generated by the flashlight Ansible role — do not edit by hand.
RUST_LOG={{ flashlight_rust_log }}
FLASHLIGHT_BIND=0.0.0.0:8080
FLASHLIGHT_ZENOH_ENDPOINT={{ flashlight_zenoh_endpoint }}
{% if flashlight_zenoh_mtls_enabled %}
FLASHLIGHT_ZENOH_MTLS_ENABLED=true
FLASHLIGHT_ZENOH_TLS_ROOT_CA={{ flashlight_ca_root_container_path }}
FLASHLIGHT_ZENOH_TLS_CLIENT_CERT=/etc/flashlight/zenoh-client-cert.pem
FLASHLIGHT_ZENOH_TLS_CLIENT_KEY=/etc/flashlight/zenoh-client-key.pem
{% endif %}
{% if flashlight_panoscope_origin | default('') %}
FLASHLIGHT_PANOSCOPE_ORIGIN={{ flashlight_panoscope_origin }}
{% endif %}
{% if flashlight_sibling_stethoscope_url | default('') %}
FLASHLIGHT_SIBLING_STETHOSCOPE_URL={{ flashlight_sibling_stethoscope_url }}
{% endif %}
{% if flashlight_portal_url | default('') %}
FLASHLIGHT_PORTAL_URL={{ flashlight_portal_url }}
FLASHLIGHT_PORTAL_API_KEY={{ flashlight_portal_api_key | default('') }}
{% endif %}
{#
  Display-only lexicon (docs/design/portal-lexicon.md). Sourced from the
  SAME portal_lex_org group_var the portal + panoscope read, so the
  participant noun never drifts across surfaces. Unset → no line →
  flashlight keeps its byte-stable "vendor" default. Render-time only.
#}
{% set _lex_org = flashlight_lex_org | default(portal_lex_org | default('')) %}
{% set _lex_orgs = flashlight_lex_orgs | default(portal_lex_orgs | default('')) %}
{% if _lex_org %}
FLASHLIGHT_LEX_ORG={{ _lex_org }}
{% endif %}
{% if _lex_orgs %}
FLASHLIGHT_LEX_ORGS={{ _lex_orgs }}
{% endif %}
