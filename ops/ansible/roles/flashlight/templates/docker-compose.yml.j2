# Generated by the flashlight Ansible role — do not edit by hand.
services:
  flashlight:
    image: "{{ flashlight_image }}"
    container_name: flashlight
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: 1152M
    restart: unless-stopped
    networks:
      # `mgmt` — Traefik resolves flashlight:8080 over this network.
      - "{{ flashlight_traefik_network }}"
{% if flashlight_join_zenoh_network | bool %}
      # `zenoh_default` — flashlight reaches zenoh-router:7447 over this.
      - "{{ flashlight_zenoh_network }}"
{% endif %}
    expose:
      - "8080"
{% if flashlight_portal_url | default('') %}
    # Resolve the portal hostname to the portal host's mesh IP so GET /api/directory
    # can reach the registry from inside the container (mirrors the
    # stethoscope role's portal host-entry).
    extra_hosts:
      - "{{ flashlight_portal_host_entry }}"
{% endif %}
    env_file:
      - .env
{% if flashlight_zenoh_mtls_enabled %}
    volumes:
      - "{{ flashlight_zenoh_client_cert }}:/etc/flashlight/zenoh-client-cert.pem:ro"
      - "{{ flashlight_zenoh_client_key }}:/etc/flashlight/zenoh-client-key.pem:ro"
      - "{{ flashlight_ca_root }}:{{ flashlight_ca_root_container_path }}:ro"
{% endif %}
    # No Traefik docker labels — the deploy uses file-provider
    # routing via /etc/traefik/dynamic/{{ flashlight_traefik_dynamic_filename }}.
    labels:
      - "traefik.enable=false"

networks:
  "{{ flashlight_traefik_network }}":
    external: true
    name: "{{ flashlight_traefik_network }}"
{% if flashlight_join_zenoh_network | bool %}
  "{{ flashlight_zenoh_network }}":
    external: true
    name: "{{ flashlight_zenoh_network }}"
{% endif %}
