# Generated by the microscope Ansible role — do not edit by hand.
# ADR 1090 Phase C. Fence chain: Traefik (mesh-only) →
# oauth2-proxy-microscope:4180 (group gate) → microscope:9750.
services:
  microscope:
    image: "{{ microscope_image }}"
    container_name: microscope
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: 6208M
    restart: unless-stopped
    networks:
      - "{{ microscope_traefik_network }}"
    expose:
      - "9750"
    extra_hosts:
      - "{{ microscope_portal_host_entry }}"
{% if microscope_netbird_url | length > 0 and microscope_netbird_host_addr | length > 0 %}
      # NetBird management API name -> the host's traefik (microscope_netbird_host_addr).
      - "{{ microscope_netbird_url | urlsplit('hostname') }}:{{ microscope_netbird_host_addr }}"
{% endif %}
    env_file:
      - .env
    volumes:
{% if microscope_console_audit_mount_enabled %}
      # Console audit stream (source S2) — READ-ONLY interim leg for gap
      # G1 until the console's audit fan-out lands.
      - "{{ microscope_console_audit_path }}:/data/console-audit.jsonl:ro"
{% endif %}
      # View-audit trail (every look recorded) — append-only JSONL.
      - "{{ microscope_view_audit_dir }}:/var/lib/microscope"
    labels:
      - "traefik.enable=false"

{% if microscope_oauth2_proxy_enabled %}
  oauth2-proxy-microscope:
    image: "{{ microscope_oauth2_proxy_image }}"
    container_name: oauth2-proxy-microscope
    # Memory ceiling: 4x the 7-day peak working set, floor 512M. An unbounded
    # leak on a shared host takes the identity plane down with it.
    deploy:
      resources:
        limits:
          memory: 512M
    restart: unless-stopped
    networks:
      - "{{ microscope_traefik_network }}"
    expose:
      - "4180"
    # OIDC discovery hits the issuer's mesh-DNS name — pin it.
    extra_hosts:
      - "{{ microscope_oauth2_proxy_oidc_host_entry }}"
    env_file:
      - oauth2-proxy-microscope.env
    labels:
      - "traefik.enable=false"
{% endif %}

networks:
  "{{ microscope_traefik_network }}":
    external: true
    name: "{{ microscope_traefik_network }}"
