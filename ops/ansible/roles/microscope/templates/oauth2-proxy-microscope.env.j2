# Rendered by ops/ansible/roles/microscope/ — DO NOT EDIT ON HOST.
# Mode 0600 root:root. Consumed by oauth2-proxy-microscope in
# docker-compose.yml. Mirrors oauth2-proxy-id-console / relay-health
# (ADR 0860). The app reads X-Forwarded-Groups ONLY, so
# PASS_USER_HEADERS is load-bearing, not cosmetic.

# --- OIDC provider (site Hydra) ---
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ microscope_oauth2_proxy_oidc_issuer_url }}
OAUTH2_PROXY_CLIENT_ID={{ microscope_oauth2_proxy_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ microscope_oauth2_proxy_client_secret }}

# `groups` is load-bearing for the admin gate; offline_access enables silent refresh.
OAUTH2_PROXY_SCOPE=openid profile email groups offline_access

# --- Authorization: identity-administration groups only (case-sensitive, F-198) ---
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_ALLOWED_GROUPS={{ microscope_oauth2_proxy_allowed_groups }}

# --- Cookie / session ---
OAUTH2_PROXY_COOKIE_SECRET={{ microscope_oauth2_proxy_cookie_secret }}
OAUTH2_PROXY_COOKIE_DOMAINS={{ microscope_hostname }}
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=8h
# SESSION_COOKIE_MINIMAL — the fix for "every refresh asks me to log in again".
#
# With no session store configured, oauth2-proxy defaults to `cookie` and packs
# the WHOLE session into it: id_token + access_token + refresh_token, plus the
# groups claim this fence gates on. That exceeds the browser's per-cookie limit
# and the cookie is dropped, so the session evaporates within a minute or two
# of a successful login. Measured: one AuthSuccess at
# 12:57:09, then re-auth at 12:58:35 and 12:58:56 — 86 s after establishing a
# session with an 8 h expiry.
#
# `minimal` stores only what the fence actually needs — email, user, groups —
# and drops the three tokens, which nothing downstream reads here
# (SET_AUTHORIZATION_HEADER and SET_XAUTHREQUEST are both false, and
# PASS_USER_HEADERS uses the session fields, not the tokens).
#
# COOKIE_REFRESH is REMOVED because it is mutually exclusive with minimal: a
# refresh needs the refresh token that minimal deliberately does not keep.
# Consequence, stated rather than discovered later: the session now lives to
# COOKIE_EXPIRE (8 h) and is not silently renewed at 1 h. That is not a
# regression in practice — Kratos holds a 24 h SSO session, so the re-auth at
# 8 h is a redirect, not a password prompt.
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true

# --- Listener / routing ---
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_WHITELIST_DOMAINS={{ microscope_hostname }}
OAUTH2_PROXY_REDIRECT_URL=https://{{ microscope_hostname }}/oauth2/callback

# --- Upstream: the microscope app ---
OAUTH2_PROXY_UPSTREAMS=http://microscope:9750

# Pass identity downstream — the app's in-app PEP consumes
# X-Forwarded-{Email,Groups}.
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=false
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=false

# Skip the provider-button page; jump straight to Hydra.
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

# --- Logging (auth denials ship via goat-logship's oauth2_proxy source) ---
OAUTH2_PROXY_REQUEST_LOGGING=true
