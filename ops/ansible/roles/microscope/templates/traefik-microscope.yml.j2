# Generated by the microscope Ansible role — do not edit on host.
# Rendered to {{ microscope_traefik_dynamic_dir }}/{{ microscope_traefik_dynamic_filename }}.
#
# Fence chain (ADR 1090):
#   - Browser path: Traefik (mesh-only middleware, defense in depth) →
#     oauth2-proxy-microscope:4180 (identity-admin group gate) → microscope:9750.
#   - CLI path (ADR 1090 CLI-through-fence): a request carrying an operator
#     bearer matches the higher-priority `-cli` router and reaches microscope:9750
#     DIRECTLY, bypassing oauth2-proxy (a terminal can't run the browser OIDC
#     redirect). The app validates the bearer against the portal and ignores
#     X-Forwarded-* on that path, so the bypass is safe — the bearer alone
#     decides. Both routers keep the mesh-only middleware.

http:
  routers:
    {{ microscope_traefik_router_name }}:
      rule: "Host(`{{ microscope_hostname }}`)"
      priority: 10
      entryPoints:
        - websecure
      service: {{ microscope_traefik_router_name }}
{% if (microscope_traefik_mesh_only_middleware | default('') | length > 0) or (microscope_traefik_ratelimit_middleware | default('') | length > 0) %}
      middlewares:
{% if microscope_traefik_mesh_only_middleware | default('') | length > 0 %}
        - "{{ microscope_traefik_mesh_only_middleware }}"
{% endif %}
{% if microscope_traefik_ratelimit_middleware | default('') | length > 0 %}
        # Browsing rate ceiling, 50 r/s per source peer — `goat-ratelimit`
        # from mgmt-dynamic.yml.j2, attached per router (the
        # entrypoint keeps only the 3000 r/s ceiling). See
        # docs/design/surface-overload-protection.md §3.1.
        - "{{ microscope_traefik_ratelimit_middleware }}"
{% endif %}
{% endif %}
      tls:
        certResolver: {{ microscope_traefik_cert_resolver }}
{% if microscope_oauth2_proxy_enabled %}
    {{ microscope_traefik_router_name }}-cli:
      # HeaderRegexp is the Traefik v3 matcher (v2 was HeadersRegexp). The
      # (?i) makes the `Bearer` scheme case-insensitive.
      rule: "Host(`{{ microscope_hostname }}`) && HeaderRegexp(`Authorization`, `(?i)^Bearer `)"
      priority: 100
      entryPoints:
        - websecure
      service: {{ microscope_traefik_router_name }}-direct
{% if (microscope_traefik_mesh_only_middleware | default('') | length > 0) or (microscope_traefik_ratelimit_middleware | default('') | length > 0) %}
      middlewares:
{% if microscope_traefik_mesh_only_middleware | default('') | length > 0 %}
        - "{{ microscope_traefik_mesh_only_middleware }}"
{% endif %}
{% if microscope_traefik_ratelimit_middleware | default('') | length > 0 %}
        # Same browsing rate ceiling as the router above.
        - "{{ microscope_traefik_ratelimit_middleware }}"
{% endif %}
{% endif %}
      tls:
        certResolver: {{ microscope_traefik_cert_resolver }}
{% endif %}

  services:
    {{ microscope_traefik_router_name }}:
      loadBalancer:
        servers:
{% if microscope_oauth2_proxy_enabled %}
          - url: "http://oauth2-proxy-microscope:4180"
{% else %}
          # Fence disabled (bring-up only — NEVER a steady state).
          - url: "http://microscope:9750"
{% endif %}
{% if microscope_oauth2_proxy_enabled %}
    {{ microscope_traefik_router_name }}-direct:
      loadBalancer:
        servers:
          - url: "http://microscope:9750"
{% endif %}
