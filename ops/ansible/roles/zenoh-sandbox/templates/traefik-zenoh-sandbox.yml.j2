# Generated by the zenoh-sandbox Ansible role — do not edit on host.
# Rendered to {{ zenoh_sandbox_traefik_dynamic_dir }}/{{ zenoh_sandbox_traefik_dynamic_filename }}.
# Design: docs/design/zenoh-sandbox.md
#
# One hostname, two routers (priority decides), one LE cert SAN:
#   - PathPrefix(/ws) → strip /ws → ws://router:10000  (the remote_api WebSocket)
#   - everything else → http://web:80                  (the static demo SPA)
# A page served over https may only open a wss:// socket (mixed-content
# rule), so Traefik terminates TLS for both halves here and the plugin
# speaks plain ws behind it.

http:
  routers:
    {{ zenoh_sandbox_traefik_router_name }}-ws:
      # Higher priority than the catch-all web router so /ws wins.
      priority: 100
      rule: "Host(`{{ zenoh_sandbox_hostname }}`) && PathPrefix(`/ws`)"
      entryPoints:
        - websecure
      service: {{ zenoh_sandbox_traefik_router_name }}-ws
      middlewares:
{% if zenoh_sandbox_traefik_mesh_only_middleware | default('') | length > 0 %}
        - "{{ zenoh_sandbox_traefik_mesh_only_middleware }}"
{% endif %}
        - "{{ zenoh_sandbox_traefik_router_name }}-stripprefix-ws"
      tls:
        certResolver: {{ zenoh_sandbox_traefik_cert_resolver }}

    {{ zenoh_sandbox_traefik_router_name }}-web:
      priority: 10
      rule: "Host(`{{ zenoh_sandbox_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ zenoh_sandbox_traefik_router_name }}-web
{% if zenoh_sandbox_traefik_mesh_only_middleware | default('') | length > 0 %}
      middlewares:
        # Mesh-only gating — the WHOLE auth surface for this sandbox (no
        # application-layer auth).
        - "{{ zenoh_sandbox_traefik_mesh_only_middleware }}"
{% endif %}
      tls:
        certResolver: {{ zenoh_sandbox_traefik_cert_resolver }}

  services:
    {{ zenoh_sandbox_traefik_router_name }}-ws:
      loadBalancer:
        servers:
          - url: "http://{{ zenoh_sandbox_router_container }}:{{ zenoh_sandbox_ws_port }}"
    {{ zenoh_sandbox_traefik_router_name }}-web:
      loadBalancer:
        servers:
          - url: "http://{{ zenoh_sandbox_web_container }}:80"

  middlewares:
    {{ zenoh_sandbox_traefik_router_name }}-stripprefix-ws:
      stripPrefix:
        prefixes:
          - "/ws"
