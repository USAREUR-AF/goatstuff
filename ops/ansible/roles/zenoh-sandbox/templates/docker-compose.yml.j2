# Generated by the zenoh-sandbox Ansible role — do not edit on host.
# Schema-of-record (local dev): ops/serve/zenoh-sandbox/docker-compose.yml
# Design: docs/design/zenoh-sandbox.md
#
# Isolated compose project. The router peers with nothing (no `connect:` in
# config.json5) and runs no storage backend (stateless → trivial wipe).
# Both containers join the external `mgmt` network so the signal Traefik
# resolves them by container name — being on `mgmt` does NOT peer the router
# with the trial fabric router (different process, different network, no
# zenoh-level connect).
services:
  {{ zenoh_sandbox_router_container }}:
    image: "{{ zenoh_sandbox_router_oci }}"
    container_name: "{{ zenoh_sandbox_router_container }}"
    restart: unless-stopped
    command:
      - --config
      - /etc/zenoh/config.json5
    environment:
      RUST_LOG: "info"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 1G
        reservations:
          memory: 128M
    networks:
      - "{{ zenoh_sandbox_traefik_network }}"
{% if zenoh_sandbox_publish_router_on_mesh_ip | default('') | length > 0 %}
    # Native zenoh port published on the MESH IP only (never 0.0.0.0) so
    # engineers can point the CLI / native SDK at the sandbox over the mesh.
    ports:
      - "{{ zenoh_sandbox_publish_router_on_mesh_ip }}:{{ zenoh_sandbox_router_port }}:{{ zenoh_sandbox_router_port }}"
{% endif %}
    expose:
      - "{{ zenoh_sandbox_ws_port }}"
      - "{{ zenoh_sandbox_rest_port }}"
    volumes:
      - "{{ zenoh_sandbox_config_path }}:/etc/zenoh/config.json5:ro"
      # Mount the plugin dir at the SAME path inside the container as on the
      # host, so config.json5's plugins_loading.search_dirs (which uses
      # zenoh_sandbox_plugin_dir) resolves the remote_api .so. A mismatched
      # target made zenohd search the host path inside the container, the
      # .so was "not found", and the remote_api WebSocket never came up
      # (Traefik /ws → 502). The upstream zenoh role avoids this only
      # because its host + container plugin paths happen to be identical.
      - "{{ zenoh_sandbox_plugin_dir }}:{{ zenoh_sandbox_plugin_dir }}:ro"
    # File-provider routing via /etc/traefik/dynamic/ — no docker labels.
    labels:
      - "traefik.enable=false"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:{{ zenoh_sandbox_rest_port }}/@/local/router"]
      interval: 30s
      timeout: 5s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "3"

  {{ zenoh_sandbox_web_container }}:
    image: "{{ zenoh_sandbox_web_image }}"
    container_name: "{{ zenoh_sandbox_web_container }}"
    restart: unless-stopped
    networks:
      - "{{ zenoh_sandbox_traefik_network }}"
    expose:
      - "80"
    labels:
      - "traefik.enable=false"
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "3"

networks:
  "{{ zenoh_sandbox_traefik_network }}":
    external: true
    name: "{{ zenoh_sandbox_traefik_network }}"
