# Generated by the goat-topology Ansible role (ADR 1160) — do not edit on host.
# Rendered to {{ goat_topology_traefik_dynamic_dir }}/{{ goat_topology_traefik_dynamic_filename }}.
#
# File-provider router; upstream addressed by container alias on the `mgmt`
# network. Filename distinct from neighbouring routes so a topology redeploy
# cannot stomp them.

http:
  routers:
    {{ goat_topology_traefik_router_name }}:
      rule: "Host(`{{ goat_topology_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ goat_topology_traefik_router_name }}
{% if goat_topology_traefik_mesh_only_middleware | default('') | length > 0 %}
      middlewares:
        # Mesh-only gating — middleware defined in mgmt-dynamic.yml.j2.
        - "{{ goat_topology_traefik_mesh_only_middleware }}"
{% endif %}
      tls:
        certResolver: {{ goat_topology_traefik_cert_resolver }}

  services:
    {{ goat_topology_traefik_router_name }}:
      loadBalancer:
        servers:
          # Container-internal port, reached over `mgmt`. NOT
          # goat_topology_container_port — that is the host-side 127.0.0.1 map.
          - url: "http://goat-topology:8080"
