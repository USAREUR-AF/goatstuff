# SPDX-License-Identifier: Apache-2.0
#
# goat-map parameters. Copy to .env and fill in, or use a ready-made goatnet
# profile from deploy/goatnets/. No secrets belong here — the fabric leg's
# identity is a cert on disk, referenced by path.

# ---- where the CoT comes in -------------------------------------------------
# The router carrying the sensor's canonical output.
GOATMAP_INGEST_ENDPOINT=tcp/127.0.0.1:7447
GOATMAP_INGEST_MODE=client
GOATMAP_SUBSCRIBE_KEY=sensor/cot/*

# ---- the goatnet fabric leg (optional) --------------------------------------
# Leave GOATMAP_FABRIC_ENDPOINT empty to run ingest-only: the map still
# works, it just renders what this process parsed rather than what the fabric
# carries. With it set, GeoTrackV1 is published here and read back.
GOATMAP_FABRIC_ENDPOINT=
GOATMAP_PUBLISH_PREFIX=
# Client identity for the fabric leg. GOATMAP_CERT_DIR is bind-mounted at
# /certs, so these paths are container paths under /certs.
GOATMAP_CERT_DIR=
GOATMAP_FABRIC_CERT=/certs/goat-map-cert.pem
GOATMAP_FABRIC_KEY=/certs/goat-map-key.pem
GOATMAP_FABRIC_CA=/certs/ca-root.pem

# auto  → fabric when the fabric leg is configured, else ingest
# fabric → render only what comes back off the fabric
# ingest → render what this process parsed, even if the fabric leg is up
GOATMAP_STORE_SOURCE=auto

# ---- labels shown in the UI and stamped into GeoTrackV1 ---------------------
GOATMAP_GOATNET=
GOATMAP_SENSOR=sensor
GOATMAP_SITE=
GOATMAP_NODE=

# ---- view + behaviour -------------------------------------------------------
# Initial map centre as "lon,lat".
GOATMAP_CENTER=0,0
GOATMAP_ZOOM=10
# Basemap extract under web/basemap/. Empty serves no basemap, and says so.
GOATMAP_BASEMAP=
# Drop a track this many seconds after it was last heard from.
GOATMAP_TTL_S=120
GOATMAP_LOG_LEVEL=INFO

# ---- serving ----------------------------------------------------------------
# MUST be the host's mesh IP, never 0.0.0.0 — mesh membership is the only gate.
GOATMAP_BIND_IP=127.0.0.1
GOATMAP_PORT=8081
GOATMAP_CONTAINER=goat-map
GOATMAP_IMAGE=goat-map:local

# ---- synthetic producer (optional) -----------------------------------------
# Set COMPOSE_PROFILES=synth to run it. Publishes simulated tracks under its own
# org anchor; that org must be registered synthetic:true in the portal, which is
# what makes consumers label it simulation.
COMPOSE_PROFILES=
GOATMAP_SYNTH_CERT_DIR=
GOATMAP_SYNTH_TRACKS=6
GOATMAP_SYNTH_SEED=42
GOATMAP_SYNTH_CONTAINER=goat-map-synth
