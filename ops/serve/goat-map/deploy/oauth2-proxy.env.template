# SPDX-License-Identifier: Apache-2.0
#
# oauth2-proxy fence for goat-map. Rendered by deploy/deploy.sh from the
# goatnet profile + the operator's environment; NEVER committed with values.
#
# WHY: goat-map served map.<site>.<zone> with no authentication at all. Mesh
# membership was the entire gate, so every peer on the goatnet saw every
# rendered track without logging in. For a viz plane whose whole purpose is
# multi-org sensor data, that is disqualifying.
#
# This is the FIRST of four steps (docs/design/goat-map.md §11). It establishes
# WHO the viewer is. It does not yet scope WHAT they see — that needs the
# data-roles resolver call, and until then every authenticated viewer sees
# everything this instance's cert admits. Authentication is not authorization,
# and this file should not be mistaken for the latter.
#
# Mirrors oauth2-proxy-microscope (ADR 0860).

# --- OIDC provider (site Hydra) ---
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=__ISSUER_URL__
OAUTH2_PROXY_CLIENT_ID=__CLIENT_ID__
OAUTH2_PROXY_CLIENT_SECRET=__CLIENT_SECRET__

# `groups` is load-bearing — it is the ONLY authorization input, both for this
# proxy's own group gate and for goat-map's per-viewer scoping downstream.
#
# `offline_access` is deliberately ABSENT. It requests a refresh token, which
# oauth2-proxy then stores in the session cookie, and that is what pushed this
# session over 4 KB — see SESSION_COOKIE_MINIMAL below. Nothing here refreshes
# silently, so the refresh token was pure weight.
OAUTH2_PROXY_SCOPE=openid profile email groups

# --- Authorization ---
# Any authenticated member of the allowed groups. Deliberately NOT admin-only:
# this is a situational-awareness surface, and an admin-only map defeats its
# purpose. Narrow per goatnet by setting GOATMAP_OAUTH2_ALLOWED_GROUPS.
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_ALLOWED_GROUPS=__ALLOWED_GROUPS__

# --- Cookie / session ---
# MUST decode to exactly 16, 24 or 32 bytes — oauth2-proxy builds an AES cipher
# from it and refuses to start otherwise. `openssl rand -base64 32` yields 44
# CHARACTERS and is rejected outright ("cookie_secret must be 16, 24, or 32
# bytes ... but is 44"), which crash-loops the fence and leaves the surface
# unreachable rather than open — noisy, but only after deploy. Generate with
# `openssl rand -hex 16` (32 chars).
OAUTH2_PROXY_COOKIE_SECRET=__COOKIE_SECRET__
OAUTH2_PROXY_COOKIE_DOMAINS=__HOSTNAME__
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=8h

# THE 4 KB CLIFF.
#
# By default oauth2-proxy stores the id_token, access_token AND refresh_token in
# the session cookie. With a `groups` claim and offline_access that exceeded the
# browser's 4 KB per-cookie limit, so oauth2-proxy split it across
# `_oauth2_proxy_0`, `_oauth2_proxy_1`… and logged only a WARNING:
#
#   session_store.go:170 Multiple cookies are required for this session as it
#   exceeds the 4kb cookie limit.
#
# The failure that produces is maximally confusing: the page and its scripts
# loaded fine WITH an identity, then every subsequent XHR arrived with no valid
# session and got 401. The UI showed live tracks (the SSE stream was opened
# while the session still resolved and stays open) beside a readiness panel
# reading "unavailable (401)" — so it looked like one endpoint was broken
# rather than like an auth problem.
#
# MINIMAL keeps only what is actually consumed — email, user, groups — and
# drops the three tokens. Nothing downstream reads a token: goat-map authorizes
# on X-Forwarded-Groups alone.
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true
# REQUIRED to be 0 with the above: a refresh needs the refresh_token that
# MINIMAL just dropped. oauth2-proxy refuses to start if both are set. The cost
# is that a session ends hard at COOKIE_EXPIRE instead of rolling — an 8 h
# re-login, which is the right trade against an auth failure that presents as a
# broken feature.
OAUTH2_PROXY_COOKIE_REFRESH=0

# --- Listener / routing ---
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_WHITELIST_DOMAINS=__HOSTNAME__
OAUTH2_PROXY_REDIRECT_URL=https://__HOSTNAME__/oauth2/callback

# --- Upstream: goat-map, reachable ONLY on the compose network ---
# goat-map publishes no host port of its own; the proxy is the only way in,
# so the fence cannot be walked around by dialling the mesh IP directly.
OAUTH2_PROXY_UPSTREAMS=http://__UPSTREAM_CONTAINER__:8080

# Pass identity downstream. Nothing consumes it yet — goat-map has no in-app
# PEP. It is set now so that step 2 (the data-roles resolver call) has the
# viewer's identity available without another deploy, and because
# X-Forwarded-* is the family the fleet standardised on (never the
# X-Auth-Request family).
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=false
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=false

# Skip the provider-button page; jump straight to Hydra.
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

# /healthz stays open so the container healthcheck and any prober can see
# service state without a session. It exposes counters (message rates, track
# counts, session state) and NO track data — no positions, no identifiers.
# That is a deliberate, bounded exemption, not an oversight.
OAUTH2_PROXY_SKIP_AUTH_ROUTES=^/healthz$

# --- Logging (auth denials ship via goat-logship's oauth2_proxy source) ---
OAUTH2_PROXY_REQUEST_LOGGING=true
