# GeoTrackV1, the display track of the goat map surface (USAREUR-AF/goatstuff).
# Public. One flat JSON object per track. `schema` is a constant of the format:
# the common `when` line checks it on decode and writes it on encode.
# The members a sensor message cannot hold (`kind`, `source.*`, `observed_at`,
# `producer_anchor`, `synthetic`, `org`) are keys of the module `geotrack`, and
# a conversion from another format receives them as context. `id` is derived
# in the module from `geotrack.sensor` and `uid`.
format  geo-track-v1
version 0.1.0
distribution public
source  "USAREUR-AF/goatstuff ops/serve/goat-map/schemas/geo/track.v1.schema.json (Apache-2.0)"
uses    geotrack
wire    json
when    schema  goat.geo.track.v1
kind    Track
requires geotrack.id uid geotrack.kind geotrack.sensor geotrack.site geotrack.node lat lon geotrack.observed_at geotrack.producer_anchor geotrack.synthetic
field   geotrack.id               id                string
field   uid                       label             string
field   geotrack.kind             kind              string
field   geotrack.sensor           source.sensor     string
field   geotrack.site             source.site       string
field   geotrack.node             source.node       string
field   geotrack.goatnet          source.goatnet    string
field   lat                       lat               float
field   lon                       lon               float
field   hae                       alt_m             float
field   course                    course_deg        float
field   speed_ms                  speed_mps         float
field   ce                        ce_m              float
field   le                        le_m              float
field   type                      cot_type          string
field   how                       how               string
field   display_name              descriptor        string
# The two sensor times are the sender's text where the source format kept it
# (the schema: verbatim and unrepaired), else the instant in canonical form.
# The text line is first, so it is the one encode writes (ruling 16 of 0.5).
field   time_text                 reported_at       string
field   time_ms                   reported_at       iso8601_ms
field   stale_text                stale_at          string
field   stale_ms                  stale_at          iso8601_ms
field   geotrack.observed_at      observed_at       string
field   geotrack.producer_anchor  producer_anchor   string
field   geotrack.synthetic        synthetic         bool
field   geotrack.org              org               string
# A message with no type is written with an empty one: the member is a string
# in every track the map has published.
default type ""
