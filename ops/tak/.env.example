# TAK Server environment variables
# Copy to .env and fill in values. Do NOT commit .env.

# TAK NETHOST mesh IP (assigned by Netbird at enrollment)
TAK_HOST=

# PostgreSQL password for TAK Server's database (hex-only, no base64)
TAK_PG_PASSWORD=

# Initial TAK admin password (for first login to admin interface on port 9000)
TAK_ADMIN_PASSWORD=

# TAK Server certificate password (protects .p12 keystores)
TAK_CERT_PASSWORD=

# TAK Server hostname (used in certificate SAN and DNS)
TAK_HOSTNAME=tak.netbird.legacy.example
